PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/relifex
JWT_SECRET=replace_me

# Google Fit / Google OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://localhost:4000/api/wearables/google-fit/callback

# Firebase Admin SDK
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=replace_me
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Optional external base URL for OAuth callback generation in deployments
PUBLIC_BASE_URL=http://localhost:4000
