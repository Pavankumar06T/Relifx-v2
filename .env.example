# Existing ReLifeX environment variables (unchanged) go above this line.

# --- AI Fitness Coaching (Gemini) ---
# Required for POST /api/health/fitness/coaching. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Overrides the default Gemini model used for coaching.
# GEMINI_MODEL=gemini-2.5-flash
